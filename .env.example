# Application
APP_HOST=0.0.0.0
APP_PORT=8000
# DEBUG = verbose pipeline; INFO = normal ops; WARNING+ = quieter
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://screener:screener@postgres:5432/screener
# true: apply Alembic migrations on startup. Production with real data: set false and
# run `alembic upgrade head` manually after a backup (see docs/COMMERCIAL_RUNBOOK.md).
AUTO_MIGRATE=true

# Bybit public API (no trading keys)
BYBIT_REST_BASE=https://api.bybit.com
BYBIT_WS_LINEAR=wss://stream.bybit.com/v5/public/linear

# Binance USDⓈ-M public API (signals only; never traded). false disables the whole feed.
BINANCE_ENABLED=false
BINANCE_REST_BASE=https://fapi.binance.com
BINANCE_WS_MARKET=wss://fstream.binance.com/market/stream?streams=!ticker@arr
BINANCE_KLINE_CONCURRENCY=4

# Bitget USDT-M public API (signals only; never traded). false disables the whole feed.
BITGET_ENABLED=false
BITGET_REST_BASE=https://api.bitget.com
BITGET_WS_PUBLIC=wss://ws.bitget.com/v3/ws/public
BITGET_SYMBOLS_PER_CONNECTION=40
BITGET_KLINE_CONCURRENCY=4
WS_SYMBOLS_PER_CONNECTION=100
INSTRUMENT_REFRESH_SEC=300
WS_PING_INTERVAL_SEC=10
STALE_CONNECTION_SEC=30
WS_ACK_TIMEOUT_SEC=10
# deflate: ~5.6x less traffic (~2 GB/day vs ~13 GB/day at 760 frames/s).
# none: ~15-20% less CPU per frame (~1-2% of one core); only for unmetered hosts.
WS_COMPRESSION=deflate
# Frames buffered per shard before the reader pauses the socket (never dropped).
WS_MAX_QUEUE=1024
MARKET_QUEUE_MAXSIZE=10000
KLINE_WARMUP_CONCURRENCY=8
GAP_BACKFILL_MIN_SEC=60

# Telegram bot (signals + settings). Leave empty to run market-only.
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user id (comma-separated for several admins)
ADMIN_ID=

# Monitoring bootstrap only: seeds the "Default" profile on the very first start.
# After that the active monitoring profile in PostgreSQL is the source of truth
# (/profiles, /settings); changing these values does not alter existing profiles.
ENABLE_LONG=true
LONG_THRESHOLD_PCT=40
LONG_INTERVAL_SEC=720
# Short/DROP is kept in profile JSON for compatibility but is not evaluated.
ENABLE_SHORT=false
SHORT_THRESHOLD_PCT=10
SHORT_INTERVAL_SEC=1800
ENABLE_DUMP=true
DUMP_THRESHOLD_PCT=40
DUMP_INTERVAL_SEC=900
MIN_TURNOVER_24H_USDT=100000
COOLDOWN_SEC=300
ESCALATE_STEP_PCT=2.0
RESET_RATIO=0.5
RESET_HOLD_SEC=60
EXCLUDE_SYMBOLS=
ALLOW_MIXED_HISTORY=true
SIGNAL_CORRELATION_MS=400
MAX_TICK_AGE_MS=5000

# Optional auto-trading (server-side only; Telegram can only ON/OFF)
# disabled | demo | mainnet
BYBIT_TRADING_MODE=disabled
ALLOW_MAINNET_TRADING=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
# false: after any restart/redeploy trading starts OFF (enable again via /trading).
# true: restore the last ON/OFF state saved in PostgreSQL.
TRADING_AUTO_RESUME=false
PUMP_ACTION=SHORT
DROP_ACTION=IGNORE
DUMP_ACTION=LONG
BYBIT_LEVERAGE=3
TRADE_MARGIN_PCT=2
ORDER_SIZING_PRICE=markPrice
ENTRY_ORDER_TYPE=MARKET
MAX_OPEN_POSITIONS=1
EXISTING_POSITION_POLICY=skip
STOP_LOSS_ENABLED=true
STOP_LOSS_PCT=3
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=5
MAX_SIGNAL_AGE_SECONDS=30
# Skip alerts are written to the log only; they are not sent to the admin chat.
# Position close notifications (TP / SL / manual / liquidation). Monitoring keeps running
# while Trading is OFF. Reconcile = REST fallback; window = wait for late WS events.
TRADING_NOTIFY_CLOSES=true
LIFECYCLE_RECONCILE_INTERVAL_SEC=45
LIFECYCLE_CORRELATION_WINDOW_SEC=3
LIFECYCLE_PNL_WAIT_SEC=3

# PumpScreener commercial mode (multi-user subscribers, Telegram Stars).
# false: admin-only bot exactly as before. Commercial signals never reach auto-trading.
COMMERCIAL_ENABLED=false
# One explicit trial per Telegram account, started only by the user's button.
TRIAL_DURATION_HOURS=24
# Price per 30 days in Stars (XTR, max 10000). Changes apply to new invoices only.
SUBSCRIPTION_PRICE_STARS=1500
SUBSCRIPTION_TITLE=PumpScreener Pro
# Access kept past period end while auto-renew is on (renewal arrives late).
SUBSCRIPTION_RENEWAL_GRACE_MIN=15
INVOICE_TTL_HOURS=24
INVOICE_RATE_LIMIT_PER_HOUR=5
# Bump TERMS_VERSION to make every user accept the terms again.
TERMS_VERSION=1
TERMS_URL=
SUPPORT_CONTACT=
# Delivery: Telegram allows ~30 msg/s per bot and ~1 msg/s per chat.
USER_SIGNAL_MAX_AGE_SEC=120
USER_SEND_RATE_PER_SEC=25
USER_CHAT_MIN_INTERVAL_SEC=1
USER_QUEUE_MAXSIZE=50
FANOUT_QUEUE_MAXSIZE=10000
EXPIRY_CHECK_SEC=30
USER_SIGNAL_RETENTION_DAYS=30
# Incoming updates per user (anti-flood); payments are never limited.
USER_RATE_PER_SEC=3
USER_RATE_BURST=10
