# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://screener:screener@postgres:5432/screener

# Bybit public API (no trading keys)
BYBIT_REST_BASE=https://api.bybit.com
BYBIT_WS_LINEAR=wss://stream.bybit.com/v5/public/linear
WS_SYMBOLS_PER_CONNECTION=100
INSTRUMENT_REFRESH_SEC=300
MAX_TICK_AGE_MS=5000
STALE_CONNECTION_SEC=15
MARKET_QUEUE_MAXSIZE=10000

# Telegram bot (signals + settings). Leave empty to run market-only.
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user id (comma-separated for several admins)
ADMIN_ID=

# Screener defaults (overridable via DB / Telegram)
ENABLE_LONG=true
LONG_THRESHOLD_PCT=40
LONG_INTERVAL_SEC=720
ENABLE_SHORT=true
SHORT_THRESHOLD_PCT=10
SHORT_INTERVAL_SEC=1800
ENABLE_DUMP=true
DUMP_THRESHOLD_PCT=40
DUMP_INTERVAL_SEC=900
ENABLE_VOLUME_SPIKE=false
MIN_TURNOVER_24H_USDT=100000
MIN_ABS_TURNOVER_WINDOW_USDT=10000
VOLUME_BASELINE_WINDOWS=6
COOLDOWN_SEC=300
ESCALATE_STEP_PCT=2.0
RESET_RATIO=0.5
RESET_HOLD_SEC=60
EXCLUDE_SYMBOLS=
WARMUP_SUPPRESS_UNTIL_LIVE=true
